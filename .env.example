# Copy this file to .env and fill in the key for the provider you use.
# .env is ignored by git. Never commit real keys.

# Which model answers questions: <provider>:<model>. Pick one line.
# KESTREL_MODEL=ollama:gpt-oss:20b              # local Ollama on this machine (no key)
# KESTREL_MODEL=ollama-cloud:kimi-k3.1-pro      # Ollama Cloud (needs OLLAMA_API_KEY)
# KESTREL_MODEL=openai:gpt-6.1-sol              # OpenAI (needs OPENAI_API_KEY)
KESTREL_MODEL=anthropic:claude-haiku-5-5        # Anthropic (needs ANTHROPIC_API_KEY)

# Provider keys. Only the one for your chosen provider is needed.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OLLAMA_API_KEY=

# Where local Ollama listens. Loopback addresses count as on-device.
KESTREL_OLLAMA_BASE_URL=http://127.0.0.1:11434

# Files and folders, relative to the repository root.
KESTREL_DB=data/kestrel.sqlite
KESTREL_BOTS_DIR=bots
KESTREL_SOURCE_DIR=data/source
KESTREL_DEFAULT_BOT=kestrel-products

# Embedding model, run on the CPU. Downloaded once on first ingest.
KESTREL_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# Who you are when using the assistant locally (production takes this from single sign-on).
KESTREL_USER=local-user
KESTREL_ROLES=call-centre-agent,broker,staff,operator

# Longest time, in seconds, one question may take.
KESTREL_TIMEOUT_S=120
